# SERVEUR HTTP
# ═══════════════════════════════════════════════════════════════════════════
class HandlerNexus(http.server.SimpleHTTPRequestHandler):
def do_GET(self):
if self.path in ('/', '/index.html', '/zoom.html', '/live.html'):
# Injecter les streams
html = HTML.replace("const STREAMS = {", "const STREAMS = " + json.dumps(STREAMS, ensure_ascii=False) + "; const _OLD = {")
# Le HTML contient déjà un objet STREAMS vide côté JS, on le remplace
# On va plutôt injecter via une balise script
streams_json = json.dumps(STREAMS, ensure_ascii=False)
html = HTML.replace(
"console.log('🌍 NEXUS EARTH LIVE v2.0.0 — Actif');",
f"const STREAMS = {streams_json};\nconsole.log('🌍 NEXUS EARTH LIVE v2.0.0 — Actif');"
)
# Nettoyer l'ancien objet STREAMS vide s'il existe
html = html.replace("const STREAMS = {};\n", "")

self.send_response(200)
self.send_header('Content-Type', 'text/html; charset=utf-8')
self.send_header('Cache-Control', 'no-cache')
self.end_headers()
self.wfile.write(html.encode('utf-8'))

elif self.path == '/streams.json':
self.send_response(200)
self.send_header('Content-Type', 'application/json; charset=utf-8')
self.send_header('Access-Control-Allow-Origin', '*')
self.end_headers()
self.wfile.write(json.dumps(STREAMS, ensure_ascii=False, indent=2).encode('utf-8'))

else:
self.send_response(404)
self.end_headers()
self.wfile.write(b"404 - Not Found")

def log_message(self, fmt, *args):
pass


